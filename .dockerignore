# Keep the build context small and secrets out of the image.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Secrets — never in an image layer. .env.example is the template that IS shipped.
.env
.env.*
!.env.example

# Production data dumps
*.dump

# Local artefacts
uploads/
*.log
docs/
tests/
*.md
.DS_Store
.vscode
.idea
docker/
docker-compose*.yml
Dockerfile
