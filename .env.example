# Neon is the database for EVERY environment — local, staging and production.
# Copy the connection string from the Neon console (Connection Details → psycopg).
#
# For local development use a Neon BRANCH, not the production branch: branches are
# copy-on-write forks, so they are instant to create and dropping one cannot touch
# production data.
#
# Two things to check on the string you paste:
#   * keep `?sslmode=require` — Neon refuses plaintext connections
#   * percent-encode the password if it contains @ : / ? # or &, otherwise tools that
#     parse the URL (pg_dump, psql, this app's own pooling setup) read it wrongly
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/odos_mobile?sslmode=require
SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com,your-google-ios-client-id.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=ODOS
BREVO_SENDER_EMAIL=your-verified-sender@example.com
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=10
PHONE_VERIFICATION_CODE_EXPIRE_MINUTES=10
# Arkesel SMS OTP (https://developers.arkesel.com) — use your main SMS API key
ARKESEL_API_KEY=your-arkesel-main-sms-api-key
ARKESEL_SENDER_ID=ODOS
ARKESEL_OTP_MESSAGE=Your ODOS verification code is %otp_code%. Do not share it.
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

VENDOR_COMMISSION_RATE=0.10
VENDOR_WITHDRAWAL_MINIMUM=20.0

PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret
PAYSTACK_CURRENCY=GHS
# Set to false when Paystack is on a Starter business and automatic transfers are blocked.
PAYSTACK_PAYOUTS_ENABLED=true

# Redis. Backs rate limiting, the catalog cache, and (when Celery is used) the task queue.
# Leave empty locally to disable rate limiting and caching; Celery will not work without it.
REDIS_URL=
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true

# ODOS in-app AI assistant
# Provider: gemini (recommended — free tier via Google AI Studio) | openrouter | ollama | openai
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=gemini
ASSISTANT_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Legacy OpenAI direct (only if ASSISTANT_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini


# --- Background jobs -----------------------------------------------------
# Run the five periodic jobs as in-process asyncio loops inside the API process.
#
#   true  (default) — current behaviour. Correct for a single API process.
#   false           — the Celery worker + beat pair runs them instead.
#
# Exactly one of the two must be active: leaving this true while beat is running executes every
# job twice. The Docker Compose stack sets it false and runs worker + beat.
#
# It should also be false on every API replica beyond the first, otherwise each replica runs its
# own copy of every job.
SCHEDULER_ENABLED=true
